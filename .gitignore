# ---------------------------------------------------------------------------
# OUTPUTS -- never committed
# ---------------------------------------------------------------------------
# All processed data, models and plots go here
L4_output/
# The release scripts/make_release.py assembles (rebuilt, never edited)
dist/

# Blocked by type as well, in case something is written elsewhere by mistake
*.hdf5
*.h5
*.i3
*.i3.zst
*.i3.bz2
*.i3.gz
*.parquet
*.joblib
*.pkl

# LightGBM model files (if produced outside L4_output)
L4_*_model.txt
L4_*_model.json
L4_*_report.json

# Plots
*.png
*.pdf
# exception: documentation images
!docs/*.png
# exception: technical notes and reference documents
!reference/*.pdf
# exception: the compiled deck
!presentation/oscnext_l4_noise_bdt.pdf
# exception: the weekly update scripts.  The markdown beside each PDF is the
# source (presentation/make_update_pdf.py builds it), so tracking the PDF
# cannot hide a stale one -- it shows up as a diff.
!presentation/updates/*.pdf

# Job lists and logs
L4_jobs.txt
*.log
*.out
*.err
condor_logs/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp
*~

# Git worktrees created by Claude Code agents -- a checkout of this repo
# inside this repo, never to be committed.  Only worktrees/: .claude/ may
# legitimately hold committed settings or skills.
.claude/worktrees/
